# Claude Code Docker Environment Configuration

# Web Terminal Authentication (REQUIRED - change these!)
TTYD_USERNAME=admin
TTYD_PASSWORD=changeme

# Web Terminal Port (optional, default: 7681)
TTYD_PORT=7681

# Volume Paths (optional - defaults to local directories)
# For Synology NAS, use paths like: /volume1/docker/claude/projects
CLAUDE_PROJECTS_PATH=./projects
CLAUDE_CONFIG_PATH=./config
